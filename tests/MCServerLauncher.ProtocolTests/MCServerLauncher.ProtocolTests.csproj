<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
</ItemGroup>

  <!--
    The plugin fixtures under tests/Fixtures are not members of MCServerLauncher.slnx, so during a
    solution build MSBuild cannot resolve them against the solution configuration and unsets their
    Configuration entirely (Microsoft.Common.CurrentVersion.targets, AssignProjectConfiguration).
    They then fell back to the SDK default, Debug, and those Debug binaries were what a
    `-c Release` run actually loaded. Keeping the parent configuration makes the fixtures match the
    run that consumes them, and stops their obj/bin being rebuilt in the opposite configuration
    every time the entry point changes between a solution build and `dotnet test <csproj>`.
  -->
  <PropertyGroup>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="RustyOptions" Version="0.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MCServerLauncher.Common\MCServerLauncher.Common.csproj" />
    <ProjectReference Include="..\..\src\MCServerLauncher.Daemon\MCServerLauncher.Daemon.csproj" />
    <ProjectReference Include="..\..\src\MCServerLauncher.DaemonClient\MCServerLauncher.DaemonClient.csproj" />
    <ProjectReference Include="..\..\tools\MCServerLauncher.ProtocolDocs\MCServerLauncher.ProtocolDocs.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Plugins\ExternalCompile\ExternalCompile.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\SdkGeneratedHealth\SdkGeneratedHealth.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\InstanceHealth\InstanceHealth.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\MetadataImposter\MetadataImposter.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\MetadataMalformed\MetadataMalformed.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\HandwrittenAdapterProbe\HandwrittenAdapterProbe.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\ReturnedError\ReturnedError.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\Throwing\Throwing.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\StartReturnedError\StartReturnedError.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\StartThrowing\StartThrowing.csproj" />
    <ProjectReference Include="..\Fixtures\Plugins\StartHanging\StartHanging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="CopyPluginDependencyAssembly" AfterTargets="Build">
    <Copy SourceFiles="$(PkgMicrosoft_Extensions_DependencyInjection)\lib\net10.0\Microsoft.Extensions.DependencyInjection.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
