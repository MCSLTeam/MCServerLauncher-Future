<ui:Page x:Class="MCServerLauncher.WPF.View.Pages.PluginExtensionCenterPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:i18n="clr-namespace:MCServerLauncher.WPF.Modules"
         xmlns:models="clr-namespace:MCServerLauncher.WPF.View.Pages"
         mc:Ignorable="d"
         d:DesignHeight="600" d:DesignWidth="900"
         Title="PluginExtensionCenterPage">
    <Grid Margin="35,35,35,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource TitleTextBlock}"
                           Text="{Binding [Plugin_ExtensionCenter_Title], Source={x:Static i18n:Lang.Tr}}" />
                <TextBlock Style="{StaticResource MinititleTextBlock}"
                           Text="{Binding [Plugin_ExtensionCenter_Subtitle], Source={x:Static i18n:Lang.Tr}}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- 筛选栏 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{Binding [Plugin_ExtensionCenter_TargetFilter], Source={x:Static i18n:Lang.Tr}}"
                           Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox Width="140" Margin="0,0,10,8" x:Name="TargetFilterCombo" SelectedIndex="0">
                    <ComboBoxItem Content="{Binding [Plugin_ExtensionCenter_TargetAll], Source={x:Static i18n:Lang.Tr}}" />
                    <ComboBoxItem Content="{Binding [Plugin_ExtensionCenter_TargetLocal], Source={x:Static i18n:Lang.Tr}}" />
                    <ComboBoxItem Content="{Binding [Plugin_ExtensionCenter_TargetServer], Source={x:Static i18n:Lang.Tr}}" />
                </ComboBox>
                <TextBox Width="240" MaxWidth="400" MinWidth="120" Margin="0,0,10,8"
                         x:Name="SearchTextBox"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ui:ControlHelper.PlaceholderText="{Binding [Search], Source={x:Static i18n:Lang.Tr}}" />
            </WrapPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Margin="0,0,10,8" Click="Refresh_Click">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Sync}"
                                    Content="{Binding [Refresh], Source={x:Static i18n:Lang.Tr}}" />
                </Button>
                <ToggleButton x:Name="MarketplaceToggle" Margin="0,0,10,8" Click="MarketplaceToggle_Click"
                              IsChecked="False">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Globe}"
                                    Content="{Binding [Plugin_ExtensionCenter_Marketplace], Source={x:Static i18n:Lang.Tr}}" />
                </ToggleButton>
                <ToggleButton x:Name="TrustRootsToggle" Margin="0,0,10,8" Click="TrustRootsToggle_Click"
                              IsChecked="False">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Shield}"
                                    Content="{Binding [Plugin_ExtensionCenter_TrustRoots], Source={x:Static i18n:Lang.Tr}}" />
                </ToggleButton>
                <Button Margin="0,0,0,8" Click="Install_Click">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Upload}"
                                    Content="{Binding [Plugin_ExtensionCenter_Install], Source={x:Static i18n:Lang.Tr}}" />
                </Button>
            </WrapPanel>
        </Grid>

        <!-- 批量操作栏：多选后显示 -->
        <Border Grid.Row="2" Margin="0,10,0,0" x:Name="BatchOperationBar"
                Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                CornerRadius="4" Padding="15,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="SelectedCountTextBlock"
                           Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,10,0" Click="SelectAllBatch_Click">
                        <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.SelectAll}"
                                        Content="{Binding [SelectAll], Source={x:Static i18n:Lang.Tr}}" />
                    </Button>
                    <Button Margin="0,0,10,0" Click="BatchInstallDaemon_Click">
                        <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Upload}"
                                        Content="{Binding [Plugin_ExtensionCenter_DeployDaemon], Source={x:Static i18n:Lang.Tr}}" />
                    </Button>
                    <Button Margin="0,0,10,0" Click="BatchRemove_Click">
                        <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Delete}"
                                        Content="{Binding [Delete], Source={x:Static i18n:Lang.Tr}}" />
                    </Button>
                    <Button Click="CancelSelectionBatch_Click">
                        <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Cancel}"
                                        Content="{Binding [Cancel], Source={x:Static i18n:Lang.Tr}}" />
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="3" Margin="0,12,0,0" ClipToBounds="True">
            <!-- 卡片网格 -->
            <Grid x:Name="ListViewRoot">
                <ui:GridView x:Name="ExtensionGrid"
                             ItemsSource="{Binding FilteredEntries}"
                             VerticalAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Extended"
                             SelectionChanged="ExtensionGrid_SelectionChanged">
                    <ui:GridView.ItemContainerStyle>
                        <Style TargetType="ui:GridViewItem">
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ui:GridView.ItemContainerStyle>
                    <ui:GridView.Resources>
                        <DataTemplate DataType="{x:Type models:PluginExtensionCenterEntryViewModel}">
                            <Border Style="{StaticResource StyledBorder}" VerticalAlignment="Stretch" MinHeight="150">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,14,16,0">
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource SubtitleTextBlock}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="230" VerticalAlignment="Center" />
                                        <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF107C10" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScopeKindTag}" Value="client">
                                                            <Setter Property="Background" Value="#FF0078D4" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ScopeKindTag}" Value="server">
                                                            <Setter Property="Background" Value="#FFF7630C" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ScopeKindTag}" Value="both">
                                                            <Setter Property="Background" Value="#FF744DA9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ScopeKindText}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding MetaSummary}" Style="{StaticResource CaptionTextBlock}"
                                               Margin="16,8,16,0" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="2" Margin="16,6,16,0" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextBlock}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                        <ui:DropDownButton HorizontalAlignment="Right" Margin="0,8,0,12" ShowChevronArrow="False">
                                            <ui:DropDownButton.Content>
                                                <ui:IconAndText IsTabStop="False" Icon="{x:Static ui:SegoeFluentIcons.More}"
                                                                Content="{Binding [More], Source={x:Static i18n:Lang.Tr}}" />
                                            </ui:DropDownButton.Content>
                                            <ui:DropDownButton.Flyout>
                                                <ui:MenuFlyout Placement="Bottom">
                                                    <MenuItem Header="{Binding [Plugin_ExtensionCenter_DeployDaemon], Source={x:Static i18n:Lang.Tr}}"
                                                              Tag="{Binding}" Click="CardDeployDaemon_Click">
                                                        <MenuItem.Icon>
                                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Upload}" FontSize="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding [Plugin_ExtensionCenter_EnableDaemon], Source={x:Static i18n:Lang.Tr}}"
                                                              Tag="{Binding}" Click="CardEnableDaemon_Click">
                                                        <MenuItem.Icon>
                                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" FontSize="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding [Plugin_ExtensionCenter_DisableDaemon], Source={x:Static i18n:Lang.Tr}}"
                                                              Tag="{Binding}" Click="CardDisableDaemon_Click">
                                                        <MenuItem.Icon>
                                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pause}" FontSize="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding [Plugin_ExtensionCenter_RequestDaemonRestart], Source={x:Static i18n:Lang.Tr}}"
                                                              Tag="{Binding}" Click="CardRequestDaemonRestart_Click">
                                                        <MenuItem.Icon>
                                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sync}" FontSize="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding [Plugin_ExtensionCenter_RemoveDaemon], Source={x:Static i18n:Lang.Tr}}"
                                                              Tag="{Binding}" Click="CardRemoveDaemon_Click">
                                                        <MenuItem.Icon>
                                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="{Binding [Delete], Source={x:Static i18n:Lang.Tr}}"
                                                              Tag="{Binding}" Click="CardRemoveClient_Click">
                                                        <MenuItem.Icon>
                                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ui:MenuFlyout>
                                            </ui:DropDownButton.Flyout>
                                        </ui:DropDownButton>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ui:GridView.Resources>
                </ui:GridView>
            </Grid>

            <!-- 详情视图 -->
            <Grid x:Name="DetailView" Visibility="Collapsed" Margin="0,0,0,0">
                <Border Style="{StaticResource StyledBorder}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top" Click="BackToList_Click">
                                <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Back}"
                                                Content="{Binding [Back], Source={x:Static i18n:Lang.Tr}}" />
                            </Button>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SelectedTitle" Style="{StaticResource SubtitleTextBlock}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedSubtitle" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap" Margin="0,4,10,0" />
                            </StackPanel>
                            <ui:DropDownButton Grid.Column="2" VerticalAlignment="Top" ShowChevronArrow="False">
                                <ui:DropDownButton.Content>
                                    <ui:IconAndText IsTabStop="False" Icon="{x:Static ui:SegoeFluentIcons.More}"
                                                    Content="{Binding [More], Source={x:Static i18n:Lang.Tr}}" />
                                </ui:DropDownButton.Content>
                                <ui:DropDownButton.Flyout>
                                    <ui:MenuFlyout Placement="Bottom">
                                        <MenuItem x:Name="DeployDaemonMenuItem" IsEnabled="False"
                                                  Header="{Binding [Plugin_ExtensionCenter_DeployDaemon], Source={x:Static i18n:Lang.Tr}}"
                                                  Click="DeployDaemon_Click">
                                            <MenuItem.Icon>
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Upload}" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="EnableDaemonMenuItem" IsEnabled="False"
                                                  Header="{Binding [Plugin_ExtensionCenter_EnableDaemon], Source={x:Static i18n:Lang.Tr}}"
                                                  Click="EnableDaemon_Click">
                                            <MenuItem.Icon>
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="DisableDaemonMenuItem" IsEnabled="False"
                                                  Header="{Binding [Plugin_ExtensionCenter_DisableDaemon], Source={x:Static i18n:Lang.Tr}}"
                                                  Click="DisableDaemon_Click">
                                            <MenuItem.Icon>
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pause}" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="RequestDaemonRestartMenuItem" IsEnabled="False"
                                                  Header="{Binding [Plugin_ExtensionCenter_RequestDaemonRestart], Source={x:Static i18n:Lang.Tr}}"
                                                  Click="RequestDaemonRestart_Click">
                                            <MenuItem.Icon>
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sync}" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="RemoveDaemonMenuItem" IsEnabled="False"
                                                  Header="{Binding [Plugin_ExtensionCenter_RemoveDaemon], Source={x:Static i18n:Lang.Tr}}"
                                                  Click="RemoveDaemon_Click">
                                            <MenuItem.Icon>
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem x:Name="RemoveClientMenuItem" IsEnabled="False"
                                                  Header="{Binding [Delete], Source={x:Static i18n:Lang.Tr}}"
                                                  Click="Remove_Click">
                                            <MenuItem.Icon>
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ui:MenuFlyout>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                        </Grid>
                        <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource CaptionTextBlock}"
                                   TextWrapping="Wrap" Margin="0,12,0,12" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="RenderHost" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SubtitleTextBlock}"
                           Text="{Binding [Plugin_ExtensionCenter_Empty], Source={x:Static i18n:Lang.Tr}}"
                           HorizontalAlignment="Center" Opacity="0.8" />
                <Button Margin="0,14,0,0" HorizontalAlignment="Center" Click="Install_Click">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Upload}"
                                    Content="{Binding [Plugin_ExtensionCenter_Install], Source={x:Static i18n:Lang.Tr}}" />
                </Button>
            </StackPanel>

            <!-- 信任根视图 -->
            <Grid x:Name="TrustRootsRoot" Visibility="Collapsed" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="{Binding [Plugin_ExtensionCenter_TrustRootsHint], Source={x:Static i18n:Lang.Tr}}" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListView Grid.Column="0" x:Name="TrustRootsList" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PluginTrustRootViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Publisher}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding KeyId}" Style="{StaticResource CaptionTextBlock}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Fingerprint}" Style="{StaticResource CaptionTextBlock}" FontFamily="Consolas" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding [Delete], Source={x:Static i18n:Lang.Tr}}"
                                            Tag="{Binding}" Click="TrustRootRemove_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Column="1" Width="380" Margin="20,0,0,0">
                        <TextBlock Style="{StaticResource CaptionTextBlock}" Margin="0,0,0,6"
                                   Text="{Binding [Plugin_ExtensionCenter_TrustRootAdd], Source={x:Static i18n:Lang.Tr}}" />
                        <TextBox x:Name="TrustRootPublisherBox" Margin="0,0,0,6"
                                 ui:ControlHelper.PlaceholderText="{Binding [Plugin_ExtensionCenter_TrustRootPublisher], Source={x:Static i18n:Lang.Tr}}" />
                        <TextBox x:Name="TrustRootKeyIdBox" Margin="0,0,0,6"
                                 ui:ControlHelper.PlaceholderText="{Binding [Plugin_ExtensionCenter_TrustRootKeyId], Source={x:Static i18n:Lang.Tr}}" />
                        <TextBox x:Name="TrustRootSpkiBox" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,6"
                                 ui:ControlHelper.PlaceholderText="{Binding [Plugin_ExtensionCenter_TrustRootSpki], Source={x:Static i18n:Lang.Tr}}" />
                        <TextBlock x:Name="TrustRootStatus" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button HorizontalAlignment="Left" Click="TrustRootAdd_Click">
                            <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Add}"
                                            Content="{Binding [Plugin_ExtensionCenter_TrustRootAdd], Source={x:Static i18n:Lang.Tr}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 插件市场视图 -->
            <Grid x:Name="MarketplaceRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Text="{Binding [Plugin_ExtensionCenter_MarketplaceRegistryUrl], Source={x:Static i18n:Lang.Tr}}" />
                    <TextBox Grid.Column="1" x:Name="MarketplaceUrlBox" Margin="0,0,10,0" MaxWidth="320" MinWidth="160"
                             VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" x:Name="MarketplaceSearchBox" Width="220" MaxWidth="260" Margin="0,0,10,0"
                             ui:ControlHelper.PlaceholderText="{Binding [Search], Source={x:Static i18n:Lang.Tr}}" />
                    <Button Grid.Column="3" Margin="0,0,10,0" Click="MarketplaceSearch_Click">
                        <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Search}"
                                        Content="{Binding [Plugin_ExtensionCenter_MarketplaceSearch], Source={x:Static i18n:Lang.Tr}}" />
                    </Button>
                    <Button Grid.Column="4" Click="MarketplaceCheckUpdates_Click">
                        <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Sync}"
                                        Content="{Binding [Plugin_ExtensionCenter_MarketplaceCheckUpdates], Source={x:Static i18n:Lang.Tr}}" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1">
                    <ListView x:Name="MarketplaceList"
                              ItemsSource="{Binding MarketplaceItems}"
                              SelectionChanged="MarketplaceList_SelectionChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Visibility="Visible">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PluginMarketplaceItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionTextBlock}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding [Plugin_ExtensionCenter_MarketplaceInstall], Source={x:Static i18n:Lang.Tr}}"
                                            Tag="{Binding}" Click="MarketplaceInstall_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView x:Name="UpdatesList" Visibility="Collapsed"
                              ItemsSource="{Binding MarketplaceUpdateItems}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PluginMarketplaceUpdateViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Margin="0,0,10,0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                        <TextBlock Style="{StaticResource CaptionTextBlock}" VerticalAlignment="Center">
                                            <Run Text="{Binding CurrentVersion}" /> → <Run Text="{Binding LatestVersion}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Tag="{Binding}" Click="MarketplaceUpdate_Click">
                                        <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Download}"
                                                        Content="{Binding [Plugin_ExtensionCenter_MarketplaceUpdate], Source={x:Static i18n:Lang.Tr}}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="MarketplaceStatus" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:Page>
