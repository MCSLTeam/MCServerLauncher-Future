<ui:Page x:Class="MCServerLauncher.WPF.View.Pages.PluginExtensionCenterPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:i18n="clr-namespace:MCServerLauncher.WPF.Modules"
         mc:Ignorable="d"
         d:DesignHeight="450" d:DesignWidth="800"
         Title="PluginExtensionCenterPage">
    <Grid Margin="35,0,35,35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource TitleTextBlock}"
                           Text="{Binding [Plugin_ExtensionCenter_Title], Source={x:Static i18n:Lang.Tr}}"
                           Margin="0,35,0,0" />
                <TextBlock Style="{StaticResource MinititleTextBlock}"
                           Text="{Binding [Plugin_ExtensionCenter_Subtitle], Source={x:Static i18n:Lang.Tr}}"
                           TextWrapping="Wrap" Margin="0,10,10,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,35,0,0">
                <Button Margin="0,0,8,0" Click="Refresh_Click">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Sync}"
                                    Content="{Binding [Refresh], Source={x:Static i18n:Lang.Tr}}" />
                </Button>
                <Button Click="Install_Click">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Upload}"
                                    Content="{Binding [Plugin_ExtensionCenter_Install], Source={x:Static i18n:Lang.Tr}}" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,20,0,0" Style="{StaticResource StyledBorder}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SubtitleTextBlock}"
                           Text="{Binding [Plugin_ExtensionCenter_Installed], Source={x:Static i18n:Lang.Tr}}"
                           Margin="0,0,0,10" />
                <ListBox Grid.Row="1" x:Name="ExtensionList" ItemsSource="{Binding Entries}"
                         SelectionChanged="ExtensionList_SelectionChanged"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Opacity="0.72" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Margin="0,20,0,0" Style="{StaticResource StyledBorder}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="SelectedTitle" Style="{StaticResource SubtitleTextBlock}" />
                        <TextBlock x:Name="SelectedSubtitle" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap" Margin="0,4,10,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DeployDaemonButton" Margin="0,0,8,0" Click="DeployDaemon_Click" IsEnabled="False">
                            <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Upload}"
                                            Content="{Binding [Plugin_ExtensionCenter_DeployDaemon], Source={x:Static i18n:Lang.Tr}}" />
                        </Button>
                        <Button x:Name="EnableDaemonButton" Margin="0,0,8,0" Click="EnableDaemon_Click" IsEnabled="False">
                            <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Play}"
                                            Content="{Binding [Plugin_ExtensionCenter_EnableDaemon], Source={x:Static i18n:Lang.Tr}}" />
                        </Button>
                        <Button x:Name="DisableDaemonButton" Margin="0,0,8,0" Click="DisableDaemon_Click" IsEnabled="False">
                            <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Pause}"
                                            Content="{Binding [Plugin_ExtensionCenter_DisableDaemon], Source={x:Static i18n:Lang.Tr}}" />
                        </Button>
                        <Button x:Name="RequestDaemonRestartButton" Margin="0,0,8,0" Click="RequestDaemonRestart_Click" IsEnabled="False">
                            <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Sync}"
                                            Content="{Binding [Plugin_ExtensionCenter_RequestDaemonRestart], Source={x:Static i18n:Lang.Tr}}" />
                        </Button>
                        <Button x:Name="RemoveDaemonButton" Margin="0,0,8,0" Click="RemoveDaemon_Click" IsEnabled="False">
                            <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Delete}"
                                            Content="{Binding [Plugin_ExtensionCenter_RemoveDaemon], Source={x:Static i18n:Lang.Tr}}" />
                        </Button>
                        <Button x:Name="RemoveButton" Click="Remove_Click" IsEnabled="False">
                            <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Delete}"
                                            Content="{Binding [Delete], Source={x:Static i18n:Lang.Tr}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource CaptionTextBlock}"
                           TextWrapping="Wrap" Margin="0,12,0,12" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="RenderHost" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ui:Page>
