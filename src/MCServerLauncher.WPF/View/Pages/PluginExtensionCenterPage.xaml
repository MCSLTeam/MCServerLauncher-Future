<ui:Page x:Class="MCServerLauncher.WPF.View.Pages.PluginExtensionCenterPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:i18n="clr-namespace:MCServerLauncher.WPF.Modules"
         mc:Ignorable="d"
         d:DesignHeight="450" d:DesignWidth="800"
         Title="PluginExtensionCenterPage">
    <Grid Margin="35,0,35,35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource TitleTextBlock}"
                           Text="{Binding [Plugin_ExtensionCenter_Title], Source={x:Static i18n:Lang.Tr}}"
                           Margin="0,35,0,0" />
                <TextBlock Style="{StaticResource MinititleTextBlock}"
                           Text="{Binding [Plugin_ExtensionCenter_Subtitle], Source={x:Static i18n:Lang.Tr}}"
                           TextWrapping="Wrap" Margin="0,10,10,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,35,0,0">
                <Button Margin="0,0,8,0" Click="Refresh_Click">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Sync}"
                                    Content="{Binding [Refresh], Source={x:Static i18n:Lang.Tr}}" />
                </Button>
                <Button Click="Install_Click">
                    <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Upload}"
                                    Content="{Binding [Plugin_ExtensionCenter_Install], Source={x:Static i18n:Lang.Tr}}" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,20,0,0" Style="{StaticResource StyledBorder}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SubtitleTextBlock}"
                           Text="{Binding [Plugin_ExtensionCenter_Installed], Source={x:Static i18n:Lang.Tr}}"
                           Margin="0,0,0,10" />
                <Border Grid.Row="1" Style="{StaticResource StyledBorder}" Padding="10" Margin="0,0,0,10" Opacity="0.72">
                    <StackPanel>
                        <Button IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Package}"
                                            Content="{Binding [Plugin_ExtensionCenter_Marketplace], Source={x:Static i18n:Lang.Tr}}" />
                        </Button>
                        <TextBlock Style="{StaticResource CaptionTextBlock}"
                                   Text="{Binding [Plugin_ExtensionCenter_MarketplaceUnavailable], Source={x:Static i18n:Lang.Tr}}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <ListBox Grid.Row="2" x:Name="ExtensionList" ItemsSource="{Binding Entries}"
                         SelectionChanged="ExtensionList_SelectionChanged"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Opacity="0.72" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Margin="0,20,0,0" Style="{StaticResource StyledBorder}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="SelectedTitle" Style="{StaticResource SubtitleTextBlock}" />
                        <TextBlock x:Name="SelectedSubtitle" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap" Margin="0,4,10,0" />
                    </StackPanel>
                    <ui:DropDownButton Grid.Column="1" VerticalAlignment="Top" ShowChevronArrow="False">
                        <ui:DropDownButton.Content>
                            <ui:IconAndText IsTabStop="False" Icon="{x:Static ui:SegoeFluentIcons.More}"
                                            Content="{Binding [More], Source={x:Static i18n:Lang.Tr}}" />
                        </ui:DropDownButton.Content>
                        <ui:DropDownButton.Flyout>
                            <ui:MenuFlyout Placement="Bottom">
                                <MenuItem x:Name="DeployDaemonMenuItem" IsEnabled="False" Header="{Binding [Plugin_ExtensionCenter_DeployDaemon], Source={x:Static i18n:Lang.Tr}}" Click="DeployDaemon_Click">
                                    <MenuItem.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Upload}" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="EnableDaemonMenuItem" IsEnabled="False" Header="{Binding [Plugin_ExtensionCenter_EnableDaemon], Source={x:Static i18n:Lang.Tr}}" Click="EnableDaemon_Click">
                                    <MenuItem.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="DisableDaemonMenuItem" IsEnabled="False" Header="{Binding [Plugin_ExtensionCenter_DisableDaemon], Source={x:Static i18n:Lang.Tr}}" Click="DisableDaemon_Click">
                                    <MenuItem.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pause}" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="RequestDaemonRestartMenuItem" IsEnabled="False" Header="{Binding [Plugin_ExtensionCenter_RequestDaemonRestart], Source={x:Static i18n:Lang.Tr}}" Click="RequestDaemonRestart_Click">
                                    <MenuItem.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sync}" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="RemoveDaemonMenuItem" IsEnabled="False" Header="{Binding [Plugin_ExtensionCenter_RemoveDaemon], Source={x:Static i18n:Lang.Tr}}" Click="RemoveDaemon_Click">
                                    <MenuItem.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="RemoveClientMenuItem" IsEnabled="False" Header="{Binding [Delete], Source={x:Static i18n:Lang.Tr}}" Click="Remove_Click">
                                    <MenuItem.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ui:MenuFlyout>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </Grid>

                <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource CaptionTextBlock}"
                           TextWrapping="Wrap" Margin="0,12,0,12" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="RenderHost" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ui:Page>
